{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionPayload",
  "description": "Zero-code ingest schema for Universal Decision Architecture™ decisions",
  "type": "object",
  "required": ["decisionType", "officialName", "initiatorObjectId", "decisionMakerObjectId"],
  "properties": {
    "decisionType": {
      "type": "string",
      "description": "One of 22 canonical decision types (e.g. decision, recommendation, priority) or custom string"
    },
    "officialName": { "type": "string" },
    "initiatorObjectId": { "type": "string" },
    "decisionMakerObjectId": { "type": "string" },
    "slug": { "type": "string" },
    "purpose": { "type": "string" },
    "affectedObjectIds": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "reviewStatus": {
      "type": "string",
      "enum": ["not_required", "pending", "in_review", "approved", "rejected", "returned", "deferred"]
    },
    "reviewThreshold": {
      "type": "string",
      "enum": ["human-review", "founder-approval", "council-review", "constitutional-review"]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "participant-visible",
        "workspace-visible",
        "institution-visible",
        "founder-visible",
        "public",
        "canonical"
      ]
    },
    "correlationId": { "type": "string" },
    "metadata": { "type": "object" },
    "intent": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "sourceObjectId": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["personal", "workspace", "company", "institution", "marketplace", "canon", "civilization"]
        },
        "constraintObjectIds": { "type": "array", "items": { "type": "string" } },
        "relevantObjectIds": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["rationale"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "type": "string", "enum": ["low", "medium", "high", "verified"] },
        "rationale": { "type": "string" }
      }
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceObjectId", "summary"],
        "properties": {
          "sourceObjectId": { "type": "string" },
          "summary": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high", "verified"] },
          "relevance": { "type": "string" }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": { "type": "string" },
          "rejectedBecause": { "type": "string" }
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "benefit", "cost", "risk"],
        "properties": {
          "option": { "type": "string" },
          "benefit": { "type": "string" },
          "cost": { "type": "string" },
          "risk": { "type": "string" }
        }
      }
    }
  }
}
