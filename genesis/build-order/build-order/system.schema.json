{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildOrderSystemRecord",
  "type": "object",
  "required": [
    "systemId",
    "officialName",
    "architecturalPhase",
    "priority",
    "dependencies",
    "dependents",
    "blockedBy",
    "blocks",
    "complexity",
    "businessValue",
    "platformValue",
    "estimatedBuildTime",
    "architecturalReadiness",
    "implementationReadiness",
    "rewriteRisk",
    "technicalDebtRisk",
    "currentStatus",
    "topologicalOrder"
  ],
  "properties": {
    "systemId": { "type": "string" },
    "officialName": { "type": "string" },
    "purpose": { "type": "string" },
    "architecturalPhase": { "type": "integer", "minimum": 0, "maximum": 9 },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
    "topologicalOrder": { "type": "integer", "minimum": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "dependents": { "type": "array", "items": { "type": "string" } },
    "blockedBy": { "type": "array", "items": { "type": "string" } },
    "blocks": { "type": "array", "items": { "type": "string" } },
    "complexity": { "enum": ["low", "medium", "high"] },
    "businessValue": { "enum": ["highest", "high", "medium", "low"] },
    "platformValue": { "enum": ["highest", "high", "medium", "low"] },
    "estimatedBuildTime": { "type": "string" },
    "architecturalReadiness": { "enum": ["high", "medium", "low", "shipped"] },
    "implementationReadiness": { "enum": ["high", "medium", "low", "shipped"] },
    "rewriteRisk": { "enum": ["low", "medium", "high", "critical"] },
    "technicalDebtRisk": { "enum": ["low", "medium", "high", "critical"] },
    "currentStatus": {
      "enum": ["planned", "in_progress", "implemented", "blocked", "deferred"]
    }
  }
}
