{
  "functions": {
    "api/live-try-on-ensure-overlays.ts": {
      "maxDuration": 10
    },
    "api/live-try-on-resolve.ts": {
      "maxDuration": 30
    },
    "api/live-try-on-studio-render.ts": {
      "maxDuration": 60
    },
    "api/live-try-on-studio-render-status.ts": {
      "maxDuration": 30
    },
    "api/live-try-on-studio-makeup.ts": {
      "maxDuration": 30
    },
    "api/admin/live-try-on-batch-step.ts": {
      "maxDuration": 120
    },
    "api/admin/live-try-on-batch-status.ts": {
      "maxDuration": 60
    },
    "api/wig-preview/live-noir-color.ts": {
      "maxDuration": 300
    },
    "api/live-wig-after-color-styling.ts": {
      "maxDuration": 300
    },
    "api/hairstyle-analysis-generate.ts": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/fonts/*.ttf,public/assets/NOIR/filled-star.png,public/assets/NOIR/star-symbol.png"
    },
    "api/admin/consult-quotes.ts": {
      "maxDuration": 60
    },
    "api/admin/meeting-client-alert.ts": {
      "maxDuration": 60
    },
    "api/admin/generate-email-hero.ts": {
      "maxDuration": 120
    },
    "api/admin/studio-generate-asset.ts": {
      "maxDuration": 120,
      "includeFiles": "public/assets/marble-half.png,public/assets/NOIR/noir-thumb.png"
    },
    "api/admin/context-capsule.ts": {
      "maxDuration": 60,
      "includeFiles": "StudioOS_ContextCapsule_v0.1/**,api/_lib/context-capsule-build-manifest.json,api/_lib/context-capsule-release.json",
      "excludeFiles": "public/assets/**,dist/**"
    },
    "api/capsules/context-latest.ts": {
      "includeFiles": "public/downloads/context-capsules/latest.zip,api/_lib/context-capsule-release.json"
    },
    "api/capsules/founder-intelligence-latest.ts": {
      "includeFiles": "public/downloads/founder-intelligence-capsules/latest.zip,api/_lib/founder-intelligence-capsule-release.json"
    },
    "api/capsules/onboarding-latest.ts": {
      "includeFiles": "public/downloads/onboarding-packs/latest.zip,api/_lib/onboarding-pack-release.json"
    }
  },
  "crons": [
    {
      "path": "/api/booking/autopay-final-payment",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expiring-rewards-emails",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/context/latest",
      "destination": "/api/capsules/context-latest"
    },
    {
      "source": "/onboarding/latest",
      "destination": "/api/capsules/onboarding-latest"
    },
    {
      "source": "/founder-intelligence/latest",
      "destination": "/api/capsules/founder-intelligence-latest"
    },
    {
      "source": "/founder/latest",
      "destination": "/api/capsules/founder-intelligence-latest"
    },
    {
      "source": "/((?!api/|assets/|downloads/|context/release\\.json|founder-intelligence/release\\.json|onboarding/release\\.json|tiktok[^/]*\\.txt|ne_110m_land\\.geojson|ne_110m_admin_0_boundary_lines_land\\.geojson|ne_110m_admin_1_states_provinces_lines\\.geojson).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
