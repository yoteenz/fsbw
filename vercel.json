{
  "functions": {
    "api/live-wig-after-color-styling.ts": {
      "maxDuration": 300
    },
    "api/admin/consult-quotes.ts": {
      "maxDuration": 60
    },
    "api/admin/meeting-client-alert.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/booking/autopay-final-payment",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
