      "maxDuration": 30,
      "includeFiles": "api/_lib/creativeProduction/studio-os-server.bundle.js"
    },
    "api/admin/context-capsule.ts": {
      "maxDuration": 60,
      "includeFiles": "StudioOS_ContextCapsule_v0.1/**,api/_lib/context-capsule-build-manifest.json,api/_lib/context-capsule-release.json",
      "excludeFiles": "public/assets/**,dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/booking/autopay-final-payment",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expiring-rewards-emails",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/context/latest",
      "destination": "/downloads/context-capsules/latest.zip"
    },
    {
      "source": "/onboarding/latest",
      "destination": "/downloads/onboarding-packs/latest.zip"
    },
    {
      "source": "/founder-intelligence/latest",
      "destination": "/downloads/founder-intelligence-capsules/latest.zip"
    },
    {
      "source": "/founder/latest",
      "destination": "/downloads/founder-intelligence-capsules/latest.zip"
    },
    {
      "source": "/collaboration-intelligence/latest",
      "destination": "/downloads/collaboration-intelligence-capsules/latest.zip"
    },
    {
      "source": "/context-updates/latest",
      "destination": "/downloads/context-updates/latest.zip"
    },
    {
      "source": "/((?!api/|assets/|downloads/|context/release\\.json|founder-intelligence/release\\.json|onboarding/release\\.json|collaboration-intelligence/release\\.json|context-updates/release\\.json|tiktok[^/]*\\.txt|ne_110m_land\\.geojson|ne_110m_admin_0_boundary_lines_land\\.geojson|ne_110m_admin_1_states_provinces_lines\\.geojson).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/context/latest",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"StudioOS_ContextCapsule_v0.3.2.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "X-Capsule-Version",
          "value": "0.3.2"
        },
        {
          "key": "X-Capsule-Artifact",
          "value": "StudioOS_ContextCapsule_v0.3.2.zip"
