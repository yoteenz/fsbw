# Copy to `.env.e2e.local` (gitignored) for signed-in Playwright projects.
# Guest smoke tests run without these.

# Site under test (default in playwright.config.ts: https://fsbw.vercel.app)
# E2E_BASE_URL=https://fsbw.vercel.app

# Local dev server instead of deployed site:
# E2E_BASE_URL=http://localhost:3001
# E2E_LOCAL_SERVER=1

# Standard (non-premium) Supabase test account — email confirmed in Supabase Auth
E2E_STANDARD_EMAIL=
E2E_STANDARD_PASSWORD=

# Premium test account (active subscription or BLACK tier in Supabase profiles)
E2E_PREMIUM_EMAIL=
E2E_PREMIUM_PASSWORD=
