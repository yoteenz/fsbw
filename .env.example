# Add project-specific env vars here (e.g. for local dev).
# Copy to .env.local and fill in values.

# --- Backend sync (Supabase + API) ---
# Get these from: Supabase project → Settings → API
# VITE_* are used by the frontend; others by Vercel API routes.

# Frontend (required for sign-in/sync when using backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# API base URL for the app to call (leave empty if frontend and API are same origin, e.g. Vercel deploy)
# For local dev: set to your deployed app URL (e.g. https://your-app.vercel.app) so Delete Account and other API calls work; the dev server will proxy /api to this URL.
VITE_API_BASE=

# Optional: same as VITE_API_BASE; used by Vite dev server to proxy /api when running locally (e.g. https://your-app.vercel.app)
# VITE_DEV_PROXY_TARGET=

# Server (Vercel API routes / serverless) – set these in Vercel project env or .env
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Optional: use service role key for admin operations (bypass RLS). Otherwise anon key + user JWT is used.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Session restore (Safari / browser close). Used by API routes only. Required for sign-in to persist after closing the browser.
# Generate a random string (e.g. 32+ chars). Set in .env.local for local dev and in Vercel → Settings → Environment Variables for production.
# SESSION_COOKIE_SECRET=your_random_secret_at_least_16_chars

# Admin emails (comma-separated). Frontend: who can access /admin and see "Sync my account". Backend: who can call /api/admin/sync-profile.
# Frontend (local): VITE_ADMIN_EMAILS=ayoteenz@yahoo.com,your-supabase@email.com
# Vercel: ADMIN_EMAILS=ayoteenz@yahoo.com,your-supabase@email.com
# VITE_ADMIN_EMAILS=
# ADMIN_EMAILS=
