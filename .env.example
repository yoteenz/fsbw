# Add project-specific env vars here (e.g. for local dev).
# Copy to .env.local and fill in values.

# --- Backend sync (Supabase + API) ---
# Get these from: Supabase project → Settings → API
# VITE_* are used by the frontend; others by Vercel API routes.

# Frontend (required for sign-in/sync when using backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# API base URL for the app to call (leave empty if frontend and API are same origin, e.g. Vercel deploy)
# For local dev: set to your deployed app URL (e.g. https://your-app.vercel.app) so Delete Account and other API calls work; the dev server will proxy /api to this URL.
VITE_API_BASE=

# Optional: same as VITE_API_BASE; used by Vite dev server to proxy /api when running locally (e.g. https://your-app.vercel.app)
# VITE_DEV_PROXY_TARGET=

# Server (Vercel API routes / serverless) – set these in Vercel project env or .env
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Optional: use service role key for admin operations (bypass RLS). Otherwise anon key + user JWT is used.
# Required for DELETE /api/delete-account (self-service delete in Account → Settings).
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Live Build-a-Wig NOIR color preview (admin only, POST /api/wig-preview/live-noir-color) ---
# FAL_KEY=...                                    # same as batch scripts; server-side only
# WIG_PREVIEW_STORAGE_BUCKET=live-preview        # bucket for wig-preview-live/... webp files
# WIG_PREVIEW_PROMPT_VERSION=v1
# Public URLs fal can fetch (your deployed site or Supabase public objects). One gray-brick mannequin per angle — no separate logo file; logo is prompt text only.
# WIG_PREVIEW_NOIR_MANNEQUIN_FRONT_URL=https://.../noir%20front.png
# WIG_PREVIEW_NOIR_MANNEQUIN_LEFT_URL=https://.../noir%20left.png
# WIG_PREVIEW_NOIR_MANNEQUIN_RIGHT_URL=https://.../noir%20right.png
# Optional: fal resolution for live **color** only (default 4K). Use 1K or 2K if timeouts or cost.
# WIG_PREVIEW_FAL_RESOLUTION=4K
# Optional: override resolution for **after-color styling** (middle+layers, two images per fal). Defaults to 2K if unset (lighter than color-only 4K).
# WIG_PREVIEW_FAL_STYLING_RESOLUTION=2K

# After-color live styling (NOIR middle + layers): POST /api/live-wig-after-color-styling — same FAL_KEY, bucket, Supabase keys as above.
# Style inspo (middle + layers look), one public URL per angle — second fal attachment; first = color WebP from Storage.
# WIG_PREVIEW_NOIR_MIDDLE_LAYERS_STYLE_FRONT_URL=https://.../middle-layers-front.png
# WIG_PREVIEW_NOIR_MIDDLE_LAYERS_STYLE_LEFT_URL=https://.../middle-layers-left.png
# WIG_PREVIEW_NOIR_MIDDLE_LAYERS_STYLE_RIGHT_URL=https://.../middle-layers-right.png

# Optional: block self-service delete for one email (default in code: kateenaarmstrong@gmail.com). Leave unset to use default.
# PROTECTED_ACCOUNT_EMAIL=kateenaarmstrong@gmail.com

# Session restore (Safari / browser close). Used by API routes only. Required for sign-in to persist after closing the browser.
# Generate a random string (e.g. 32+ chars). Set in .env.local for local dev and in Vercel → Settings → Environment Variables for production.
# SESSION_COOKIE_SECRET=your_random_secret_at_least_16_chars

# Admin emails (comma-separated). Frontend: who can access /admin and see "Sync my account". Backend: who can call /api/admin/sync-profile.
# Frontend (local): VITE_ADMIN_EMAILS=kateenaarmstrong@gmail.com,your-supabase@email.com
# Vercel: ADMIN_EMAILS=kateenaarmstrong@gmail.com,your-supabase@email.com
# VITE_ADMIN_EMAILS=
# ADMIN_EMAILS=

# --- Stripe (premium membership subscriptions) ---
# Create three recurring Prices in Stripe Dashboard (3 / 6 / 12 month intervals) matching app chart amounts ($280 / $520 / $960 USD).
# Webhook URL: https://YOUR_DEPLOYMENT/api/stripe/webhook — events: checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted, payment_intent.succeeded (product orders; see docs/CHECKOUT_SERVER_QUOTE.md)
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_3MONTHS=price_...
# STRIPE_PRICE_ID_6MONTHS=price_...
# STRIPE_PRICE_ID_12MONTHS=price_...
# Public site origin for Checkout return URLs (required in production)
# SITE_URL=https://your-app.vercel.app
# SUPABASE_SERVICE_ROLE_KEY is required for webhook + create-checkout-session profile updates and admin membership payment list.

# --- Admin newsletter (Marketing → Newsletter tab) ---
# Resend: https://resend.com — verify your domain; free tier can use onboarding@resend.dev for tests only.
# RESEND_API_KEY=re_...
# NEWSLETTER_FROM_EMAIL=Frontal Slayer <newsletter@yourdomain.com>
