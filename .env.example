# Optional: enable Facebook sign-in on the sign-in page
# Create an app at https://developers.facebook.com and add your site URL to App Domains / Valid OAuth Redirect URIs
VITE_FACEBOOK_APP_ID=

# Optional: enable Google sign-in on the sign-in page
# Create OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials and add authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=
