# All In One — environment (copy to .env.local for development)

# Application
VITE_AIO_ENVIRONMENT=preview
VITE_AIO_APP_URL=http://localhost:5173

# Data mode: demo | local | supabase (default: demo when unset)
VITE_AIO_DATA_MODE=demo
VITE_AIO_AUTH_MODE=demo
VITE_AIO_STORAGE_MODE=demo

# Dedicated All In One Supabase (NOT Frontal Slayer — never use hyycomvcaqxxvyrfupes)
# VITE_AIO_SUPABASE_URL=https://YOUR-AIO-PROJECT.supabase.co
# VITE_AIO_SUPABASE_ANON_KEY=

# Server-only (CI/migrations — do not commit secrets)
# AIO_SUPABASE_SERVICE_ROLE_KEY=
# AIO_SUPABASE_PROJECT_REF=
