# All In One — environment (copy to .env.local for development)

# --- Environment identity (explicit — do not infer from hostname alone) ---
# local | demo | staging | production
VITE_AIO_ENVIRONMENT=local
VITE_AIO_APP_URL=http://localhost:5173

# --- Data modes: demo | local | supabase ---
VITE_AIO_DATA_MODE=demo
VITE_AIO_AUTH_MODE=demo
VITE_AIO_STORAGE_MODE=demo

# --- Dedicated All In One Supabase (NOT Frontal Slayer — never hyycomvcaqxxvyrfupes) ---
# Staging project (owner must create):
# VITE_AIO_STAGING_PROJECT_REF=
# VITE_AIO_SUPABASE_URL=https://YOUR-AIO-STAGING.supabase.co
# VITE_AIO_SUPABASE_ANON_KEY=
# Optional login hero override (default: bundled /brand/aio-login-hero.png; Supabase CDN when VITE_AIO_SUPABASE_URL is set)
# VITE_AIO_LOGIN_HERO_URL=
# Optional public storage base when project URL is split (…/storage/v1/object/public)
# VITE_AIO_PUBLIC_STORAGE_URL=

# Production project (separate from staging):
# VITE_AIO_PRODUCTION_PROJECT_REF=
# Production deploy uses production-specific env in host secret store

# --- Build/release metadata (CI sets these) ---
# VITE_AIO_RELEASE_ID=
# VITE_AIO_COMMIT_SHA=

# --- Server-only (CI/migrations — NEVER commit secrets, NEVER VITE_ service role) ---
# AIO_SUPABASE_SERVICE_ROLE_KEY=
# AIO_SUPABASE_PROJECT_REF=
# AIO_STAGING_PROJECT_REF=
# AIO_PRODUCTION_PROJECT_REF=
# AIO_CONFIRM_STAGING=yes
# AIO_CONFIRM_PRODUCTION=yes-i-understand-production

# --- Live RLS integration tests (scripts/rls-staging-test.sh + freightRlsIntegration.test.ts) ---
# AIO_STAGING_SUPABASE_URL=
# AIO_STAGING_SUPABASE_ANON_KEY=
# AIO_RLS_TEST_SHIPPER_A_JWT=
# AIO_RLS_TEST_SHIPPER_B_JWT=
# AIO_RLS_TEST_CARRIER_A_JWT=
# AIO_RLS_TEST_STAFF_JWT=
# AIO_RLS_TEST_SHIPPER_A_ORG=
